# Copy to .env (gitignored) and fill in real values.
#   cp .env.example .env && chmod 600 .env
# Load before launching Claude Code:
#   set -a && . ~/mcp-servers/.env && set +a

# --- Oracle ---
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_CONNECTION_STRING=host:1521/service

# --- Redis ---
REDIS_HOST=
REDIS_PORT=6379
REDIS_USER=default
REDIS_PASSWORD=

# --- MySQL (MyProject) ---
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=myproject

# --- MongoDB ---
MONGODB_URI=mongodb://user:pass@host:27017/?authSource=admin
MONGODB_DATABASE=admin
